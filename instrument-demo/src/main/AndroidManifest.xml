<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:name="android.software.midi" android:required="false" />
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <permission android:name="org.fm1.companion.demo.permission.USB_CALLBACK"
        android:protectionLevel="signature" />
    <uses-permission android:name="org.fm1.companion.demo.permission.USB_CALLBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application android:label="FM-1 Instrument" android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity android:name=".InstrumentActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service android:name=".InstrumentPlaybackService" android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
    </application>
</manifest>
