+/* Look up original committed chunks without altering their bytes. */
+static void bk_legacy_boot(void)
+{
+    uint8_t payload[4u * 888u];
+    uint32_t sequences[16] = {0};
+    for (uint32_t sector = 0; sector < 20u; sector++) {
+        uint32_t off = bk_legacy_sector(sector);
+        bk_hdr_t header;
+        if (bk_read(off, &header, sizeof header) || header.magic != 0x31424B53u ||
+            header.chunk >= 16u || header.len != sizeof payload ||
+            header.hsum != proj_hash(&header, sizeof header - 4u) ||
+            (bk.legacy_sect[header.chunk] && !bk_newer(header.seq, sequences[header.chunk])) ||
+            bk_read(off + 256u, payload, sizeof payload) ||
+            header.sum != proj_hash(payload, sizeof payload))
+            continue;
+        bk.legacy_sect[header.chunk] = (uint8_t)(sector + 1u);
+        sequences[header.chunk] = header.seq;
+        for (uint32_t i = 0; i < 4u; i++) {
+            const uint8_t *p = payload + i * 888u;
+            unsigned id = 4u * header.chunk + i;
+            bk.len[id] = p[0] >= 1u && p[0] <= 3u ? clamp((int32_t)p[2] - 64, 1, 64) : 0;
+            bk.div[id] = p[3] >= 64u && p[3] < 74u ? p[3] - 64u : 2u;
+        }
+    }
+}
+
+static int bk_legacy_read(uint32_t id, uint8_t *out)
+{
+    unsigned sector = bk.legacy_sect[id / 4u];
+    uint8_t raw[888];
+    memset(out, 0, BK_REC);
+    if (!sector || !bk.len[id]) return 0;
+    if (bk_read(bk_legacy_sector(sector - 1u) + 256u + id % 4u * sizeof raw, raw, sizeof raw))
+        return 1;
+    if (raw[0] < 1u || raw[0] > 3u || (raw[7] & 127u) > MOTION_MAX)
+        return 1;
+    memcpy(out, raw, BK_STEPS + 64u * 9u);
+    out[0] = BK_VER;
+    out[2] = (uint8_t)(bk.len[id] - 1u);
+    step_t empty = {0};
+    step_clear(&empty);
+    for (unsigned step = 64u; step < NSTEP; step++)
+        (void)step_put9(out + BK_STEPS + step * 9u, &empty);
+    memcpy(out + BK_NUDGE, raw + 584u, 48u);
+    for (unsigned i = 0; i < (raw[7] & 127u); i++) {
+        const uint8_t *old = raw + 632u + i * 4u;
+        uint8_t *record = out + BK_MOT + i * 4u;
+        record[0] = old[0] & 63u;
+        record[1] = (old[1] & 127u) | ((old[0] & 64u) << 1);
+        const int16_t value = (int16_t)(old[2] | (uint16_t)old[3] << 8);
+        if (value < -64 || value > 127) {
+            out[7] &= 128u;  /* Stock drops corrupt automation but keeps the steps. */
+            break;
+        }
+        record[2] = old[2];
+        record[3] = old[1] >> 7;
+    }
+    return 0;
 }
 
